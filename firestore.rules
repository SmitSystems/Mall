rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /rooms/{pin} {
      function isOwner() {
        return request.auth != null &&
          get(/databases/$(db)/documents/rooms/$(pin)).data.owner == request.auth.uid;
      }
      function isMember() {
        return request.auth != null && (isOwner() ||
          (exists(/databases/$(db)/documents/rooms/$(pin)/requests/$(request.auth.uid)) &&
           get(/databases/$(db)/documents/rooms/$(pin)/requests/$(request.auth.uid)).data.status == 'accepted'));
      }
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;

      match /requests/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || isOwner());
        allow list: if isOwner();
        allow create: if request.auth != null && request.auth.uid == uid
                      && request.resource.data.status == 'pending';
        allow update: if isOwner();
      }
      match /messages/{id} {
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.uid == request.auth.uid;
        allow update: if isMember() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','text','img','aud','loc']);
      }
    }
  }
}
